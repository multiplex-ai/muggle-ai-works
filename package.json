        "darwin-x64": "bcacd957fc1211054a8d9f2d23a84597fe7c191af14bc763b5774b7ccc5c3b1c"
      },
      "staging": {
        "darwin-arm64": "d108778d3f63c4d93c72fb87981e9fc79145dc186f5c81fba5141810d497f35f",
        "linux-x64": "981fd72a1d0df04c00ebe3b4c60fa8ae99dfdeefeb6491ff80899d1681396e3f",
        "win32-x64": "32f0e0a0a450abbda394491db0bb89e343ccdf73d014877fc864d63a065a7198",
        "darwin-x64": "1853f8409879e7ffafc4b42c7bde05d8bc7e7a946f125eeed434d5a6098e9a5d"
      }
