        "darwin-arm64": "385ce152f58d7016fedc2844face2945042b5913717da3aff3e6410ec8c3383b",
        "darwin-x64": "ff244891f092a8882806d9847103b8a24a89de64bb398917314128a998d49abd"
      },
      "staging": {
        "darwin-arm64": "d4d8fd58d2ac5bcc3e65a3acb28869be63fbba658e20cd0f791f9e0cecec568c",
        "linux-x64": "af3a2cf182a96cc5066c5e603b96b3231d22946969ce30ea2bf67d737335e6fd",
        "win32-x64": "b328bfad315f9c5ec772ab6756fae26884b462c840435583c2e73a4220d0f18c",
