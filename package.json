  "keywords": [
    "mcp",
    "model-context-protocol",
    "muggle-ai",
    "e2e-testing",
    "testing",
    "automation",
    "localhost",
    "ai-coding",
    "user-experience",
    "cursor",
    "claude-code",
    "vibe-coding"
  ],
  "author": "Muggle AI",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiplex-ai/muggle-ai-works.git"
