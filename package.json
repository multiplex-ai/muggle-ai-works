        "darwin-x64": "8d5d9fc4df08fbde933591847042604151801e7e5fb978598d8e045550b8707f"
      },
      "staging": {
        "darwin-arm64": "baf064bcf05a435af371e89638aac5eac4aa104aa0f362ff2dc5cc042cb3e528",
        "linux-x64": "4d57f45ff2c00b056513da2ac08568b2031283ef9a1cfbacdd7d1d7f4c41bee9",
        "win32-x64": "27917fef49fd2bbb7c35c8dc63beef07585e23c14adb358b9bab3ed0bebabcc1",
