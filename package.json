    "browser-automation",
    "real-browser",
    "pull-request",
    "coding-agent",
    "ai-agent",
    "ai-coding",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "cursor",
    "localhost",
    "vibe-coding"
  ],
  "author": "Muggle AI",
