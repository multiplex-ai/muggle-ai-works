    "@modelcontextprotocol/sdk": "^1.25.3",
    "applicationinsights": "^3.14.0",
    "axios": "^1.7.9",
    "commander": "^14.0.3",
    "open": "^11.0.0",
    "sigstore": "^5.0.0",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
