        "darwin-arm64": "c9c77f531fde1090bbb841dc103b570ea27a58e18caab8402f6114ff5db7a392",
        "darwin-x64": "8713eaca3971cef4a762171f5bb3d4f426cc3bef09830deab12db1ac50180a7d"
      },
      "staging": {
        "darwin-arm64": "f446988cbd990058a1ca284a55d92b5a58f3f2fdea37fff9ce28911fd5801197",
        "linux-x64": "40d735e3506fd8bd5ff8123ade3df2e503d3915c7951291c71d66fbe113c28e0",
        "win32-x64": "5574b7039c4af4e4f1578dd595f2170470990d9ee6817d80ccbcfdacf63da6b1",
        "darwin-x64": "a7b787d08c80bad0c12d8cda47f075b43c105f955eb4abd96d427b35790b60f1"
      }
