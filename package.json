        "darwin-arm64": "ede589c594c81544b2a713a3c8cefe087cd5116b5672f790e2c74053ce30e94b",
        "darwin-x64": "b6221cd57828ea9ad3ed7a77021e52a71933bef3471bb081956db500fe22cdde"
      },
      "staging": {
        "darwin-arm64": "a072b5708c16d6a36431aeae72046265312d14fc97d7bd62ed29dfa9cc8bd6e1",
        "linux-x64": "622b954906ee56793e87b02b4cdb52eeb28dcced5ada5ba581ad861e3e6cc38a",
        "win32-x64": "df0000e91eb55a17964949e5b3df0ead510ee2f57b4ecaeba804b645cfd0d9fc",
        "darwin-x64": "a9ba6ebc1837cb1b6995d25aaa692361f96d4ddc21101f2a927f7d4ebe59be4a"
      }
