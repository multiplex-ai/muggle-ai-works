        "darwin-arm64": "67babe01ee9b68824cafd7e548553dea421e90f37af7ae6d5e023584259a844a",
        "darwin-x64": "5c5feae1191c26c0f149e7b1f1354c3ae19c9507110fc2cd3380e8a18b537679"
      },
      "staging": {
        "darwin-arm64": "df6fef9bc0b50033bd63f35164a72b14e593c61442c8baed3f2ad738fab17138",
        "linux-x64": "0ae3066a3fdd7ed0980ea414cb73dbcf40f3e307f02e1390f1db293e9c7fa123",
        "win32-x64": "859334fa373cb466df5698308530da203e1057619319fe24e4b49658a35224ce",
        "darwin-x64": "89e37a900d02d434620a91df21d1be605e0d80862bd429603fea50457d2ece2f"
      }
