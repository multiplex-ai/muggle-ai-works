    "eslint": "^10.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "turbo": "^2.9.4",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  },
