    "electronAppSignedFromVersion": "1.10.0",
    "signerIdentityUri": "https://github.com/multiplex-ai/muggle-ai-teaching-service/.github/workflows/release-electron-app-reusable.yml@refs/heads/master"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "applicationinsights": "^3.14.0",
    "axios": "^1.7.9",
    "commander": "^14.0.3",
    "open": "^11.0.0",
    "sigstore": "^5.0.0",
    "ulid": "^3.0.2",
    "uuid": "^14.0.0",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@anthropic-ai/sdk": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@muggleai/mcp": "file:packages/mcps",
    "@muggleai/telemetry": "0.5.0",
    "@muggleai/workflows": "file:packages/workflows",
    "@types/node": "^26.6.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "rimraf": "^6.0.1",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.9.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "muggle-ai",
    "acceptance-testing",
    "acceptance-test-agent",
    "e2e",
    "e2e-testing",
    "browser-automation",
    "real-browser",
    "pull-request",
    "coding-agent",
    "ai-agent",
    "ai-coding",
    "claude-code",
    "claude-code-plugin",
    "codex",
    "cursor",
    "localhost",
    "vibe-coding"
  ],
  "author": "Muggle AI",
