        "darwin-x64": "cca36704aed389bb886bb70ade6e555c93d55a540fe05b8ea531de5bde4f9d8c"
      },
      "staging": {
        "darwin-arm64": "2512aded2d5fa4afee86d491b154a46ba367cf34072fbd609fd16531dab1f418",
        "linux-x64": "88c70c34c0764c1648600c72bbdc2625e5fdfdd1bb61f9a9e664c73302211b60",
        "win32-x64": "597464cd252050daac65e0c3f3a210b36abc33ec4a85a882cb95fc21e369243f",
        "darwin-x64": "0c1520ffa260feae7f373ce9840fd9fc847803401b73e52d930d7c00a0aa45d7"
      }
