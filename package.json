        "darwin-x64": "92c8c4cc44abdb413cb20de9ebb57e9d8026f4d92963e41e39572b41e0e67fe4"
      },
      "staging": {
        "darwin-arm64": "f2bd2b628b191be5ac5e29a1b9b6aed3e21918dd16da27d49edf4067c036b2c6",
        "linux-x64": "8cb5a8374d2291af20df6edabc5d76642f99b77526214c72025c641a4b7a3c1f",
